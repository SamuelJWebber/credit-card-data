# Copy to .env (gitignored) and fill in. Loaded by src/carddash/cli.py at startup.
# The same two values exist as Actions secrets on the repo, so CI already has them.

# FRED API key. Optional; free and instant: https://fredaccount.stlouisfed.org/apikeys
# Without it the `fred` fetcher uses FRED's keyless fredgraph.csv endpoint.
FRED_API_KEY=

# A contact email. Every request identifies this pipeline as 'carddash/<version> <this address>'.
# Required: the SEC asks for a reachable contact and refuses any User-Agent
# containing a URL, so this must be a bare email address, and issuer_8k fails without it.
CARDDASH_CONTACT=
